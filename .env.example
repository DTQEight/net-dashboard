# ============================================================
#  网络仪表盘 - 配置
#  复制为 .env 后填写真实值。  ⚠️ 本文件含密码，不要外传
# ============================================================

# ============================================================
#  登录认证（强烈建议配置）
#  不配置的话面板任何人都能打开
# ============================================================

# 用户名（默认 admin）
AUTH_USER=admin

# 登录密码（明文填这里，启动时会自动 bcrypt 加密，只存在内存里）
AUTH_PASS=改成你的登录密码

# 或者直接给 bcrypt 哈希（优先于 AUTH_PASS）
#   生成方式：docker run --rm httpd:alpine htpasswd -nbB "" "你的密码" | cut -d: -f2
# AUTH_PASS_HASH=$2y$05$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# cookie 签名密钥（不填会自动生成并保存到 data/session.key）
# 填了的话多个实例可以共享登录状态
# AUTH_SECRET=随便一串足够长的随机字符

# 登录有效期（小时，默认 168 = 7 天）
AUTH_TTL_HOURS=168

# ---------- 路由器 ----------
ROUTER_IP=192.168.31.1

# ---------- mihomo 代理 API ----------
MIHOMO_PORT=19090
MIHOMO_SECRET=改成你的面板密码

# ---------- AdGuard Home API ----------
ADGUARD_PORT=3000
ADGUARD_USER=mcdull
ADGUARD_PASS=改成你的AdGuard密码

# ---------- LibreSpeed 测速（选填，仅用于探活和启停） ----------
SPEEDTEST_PORT=18081

# ---------- Lucky（选填，填了会在快捷入口里出现） ----------
# LUCKY_PORT=16601

# ---------- 路由器 SSH（用于采集系统/无线/设备/conntrack） ----------
ROUTER_SSH_USER=root
# 方式一：密码认证（最简单）
ROUTER_SSH_PASS=改成你的路由器root密码
# 方式二：密钥认证（更安全）
# ROUTER_SSH_KEY=/app/id_rsa

# ---------- 服务监听 ----------
LISTEN=:8080

# ============================================================
#  历史数据与告警
# ============================================================

# 数据目录（对应 docker-compose 里的 ./data:/data）
DATA_DIR=/data

# 采样间隔（秒）。60 = 每小时 60 个点，7 天约 1 万个点
SAMPLE_SEC=60

# 告警阈值（超过才推送）
TEMP_ALERT=80        # 路由器温度 ℃
MEM_ALERT=92         # 路由器内存使用率 %

# ============================================================
#  通知推送（配置了哪个用哪个，可同时配多个）
#  配好后点仪表盘右上角「测试通知」验证
# ============================================================

# ---------- 企业微信 --------------------------------
# 方式一【最推荐】群机器人：建个群 → 群设置 → 群机器人 → 添加
#   复制 Webhook 地址，取 key= 后面那段填进来：
#     https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxxxxxx-xxxx-xxxx
#                                                      └── 只填这段 ──┘
#   优点：不需要可信IP、不需要代理、官方证书有效，公网 IP 变了也不影响
NOTIFY_WECOM=改成你的webhook key
#
# 方式二 自建应用：消息发给指定成员（需要可信IP + 代理，较麻烦）
# NOTIFY_WECOM_CORP=ww2af8811c1ca7cb47
# NOTIFY_WECOM_SECRET=应用Secret（在应用管理页面查看）
# NOTIFY_WECOM_AGENT=1000003
# NOTIFY_WECOM_TOUSER=@all          # @all 或指定成员账号，多个用 | 分隔
#
#   直连官方 API 的前提：调用方公网 IP 在
#   「应用管理 → 自建应用 → 开发者接口 → 企业可信IP」里，否则报 errcode=60020
#
# 方式三 自建应用走自建代理（已有 wxchat 之类代理时用）
# NOTIFY_WECOM_BASE=https://你的代理地址:端口
#   代理需能转发 /cgi-bin/gettoken 和 /cgi-bin/message/send 两个路径
#
#   ⚠️ Sakura Frp 等隧道常用自签证书，Go 会报
#      x509: certificate signed by unknown authority
#   需要开启跳过校验（有中间人风险）：
# NOTIFY_INSECURE=1

# ---------- Bark（iOS）----------
# 填 key，或完整地址
# NOTIFY_BARK=https://api.day.app/你的key
# NOTIFY_BARK=你的key

# ---------- Telegram ----------
# 格式 bot_token:chat_id
# NOTIFY_TELEGRAM=123456:ABC-DEF...:你的chatid

# ---------- ntfy（可自建）----------
# NOTIFY_NTFY=https://ntfy.sh/你的topic

# ---------- 通用 Webhook ----------
# 会 POST {"title","body","level","time"}
# 如果你用 wxchat / wecomchan 之类的中转服务，填它的接口地址
# NOTIFY_WEBHOOK=https://你的地址/notify

# 最低推送级别：info | warn | error（默认 warn）
# info = 全部（含服务恢复），warn = 只有警告，error = 只有掉线这类严重问题
# NOTIFY_MIN_LEVEL=warn

# ============================================================
#  快捷入口（不填则用默认的 AdGuard/mihomo/测速/路由器）
#  最多 8 个，n 从 1 开始
# ============================================================

# LINK_1_NAME=TP-Link
# LINK_1_URL=http://192.168.31.7/
# LINK_1_ICON=router
#
# LINK_2_NAME=NAS
# LINK_2_URL=http://192.168.31.52:9999/
# LINK_2_ICON=nas

# ============================================================
#  NAS 主机挂载点（一般不用改，与 docker-compose 对应）
# ============================================================
# HOST_ROOT=/host/root
# HOST_SYS=/host/sys
